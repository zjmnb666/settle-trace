# =============================================================================
# SettleTrace 环境变量示例
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）
#       cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库（二选一）
# -----------------------------------------------------------------------------

# ① 云 PG（Supabase / Neon）——当前使用
#    注意三点：
#      a) 必须带 ?sslmode=require，否则 asyncpg 会报 SSL 相关错误
#      b) Supabase 用 Session pooler 的 5432 端口，不要用 Transaction pooler 的 6543
#      c) 用户名形如 postgres.abcdefgh，不是 postgres
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ② 本地 Docker（如果以后装了 Docker，注释掉上面一行，启用下面这行）
# DATABASE_URL="postgresql://settletrace:settletrace@localhost:5432/settletrace"

# 没配 .env 时，代码默认连本地 Docker 那一份
DATABASE_URL="postgresql://settletrace:settletrace@localhost:5432/settletrace"

# -----------------------------------------------------------------------------
# 向量化
# -----------------------------------------------------------------------------
# mock：离线确定性哈希，不联网（维度固定 1024，与 sql/schema.sql 一致）
# openai / ollama：走 OpenAI 兼容的 /v1/embeddings
EMB_PROVIDER=mock
EMB_MODEL=text-embedding-3-small
EMB_BASE_URL=https://api.openai.com/v1
EMB_API_KEY=
# 换真模型时维度会变（如 1536），必须同步改表：
#   ALTER TABLE chunk ALTER COLUMN embedding TYPE vector(1536);
#   然后重新 python -m app.ingest
EMB_DIM=1024

# -----------------------------------------------------------------------------
# LLM（回答生成）
# -----------------------------------------------------------------------------
# mock：离线占位文本，用于验证链路
# deepseek / openai / ollama：走 OpenAI 兼容的 /v1/chat/completions
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=800

# DeepSeek 示例（取消注释并填 key）：
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxx

# -----------------------------------------------------------------------------
# 检索与对话
# -----------------------------------------------------------------------------
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP=80
RETRIEVER_POOL=12
RRF_K=60
HISTORY_ROUNDS=6
TOP_K=3
MAX_QUESTION_LEN=500

# -----------------------------------------------------------------------------
# 其他
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
